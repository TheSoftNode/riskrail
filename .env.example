# Core
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
REALTIME_PORT=4001
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Persistence
DATABASE_URL=postgresql://rivisk:rivisk@localhost:5432/rivisk?schema=public
REDIS_URL=redis://localhost:6379

# Stacks
STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
STACKS_API_KEY=
CHAINHOOK_AUTH_TOKEN=change-me

# Protocol adapters. Both are OFF unless set: without them the indexer runs
# native balances only and says nothing about it.
ZEST_V2_ENABLED=false
BITPAY_CORE_CONTRACT=

# Pricing
COINGECKO_API_KEY=

# Contracts -- the public testnet deployment (contracts/deployments/testnet.json)
RISK_REGISTRY_CONTRACT=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7.risk-registry
RISK_POLICY_CONTRACT=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7.risk-policy
PROTOCOL_REGISTRY_CONTRACT=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7.protocol-registry

# Publisher - use a secret manager in production, never commit credentials
RISK_PUBLISHER_ENABLED=false
RISK_PUBLISHER_SECRET_KEY=
# Publish an unchanged snapshot at most once per this many source blocks
# (~9.6 s each on testnet; 120 ≈ 19 min). A changed figure publishes at once.
# Keep it below the 144-block freshness bound consumers are told to use. 0 = off.
ATTESTATION_MIN_INTERVAL_BLOCKS=120

# Auth / API -- all three must be at least 32 characters. A short value does not
# stop the API booting; it fails the first request that needs it with a 500.
JWT_SECRET=replace-with-at-least-32-random-bytes
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
WEBHOOK_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# Proxies in front of the API. Rate limiting keys on client IP: 0 behind a load
# balancer puts every caller in one bucket; too high lets callers spoof it.
TRUST_PROXY_HOPS=0

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
NEXT_PUBLIC_STACKS_NETWORK=testnet
NEXT_PUBLIC_RISK_POLICY_CONTRACT=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7.risk-policy

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@rivisk.dev

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
