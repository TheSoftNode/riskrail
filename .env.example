# Core
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
REALTIME_PORT=4001
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Persistence
DATABASE_URL=postgresql://riskrail:riskrail@localhost:5432/riskrail?schema=public
REDIS_URL=redis://localhost:6379

# Stacks
STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
STACKS_API_KEY=
CHAINHOOK_AUTH_TOKEN=change-me

# Contracts (set after deployment)
RISK_REGISTRY_CONTRACT=
RISK_POLICY_CONTRACT=
PROTOCOL_REGISTRY_CONTRACT=

# Publisher - use a secret manager in production, never commit credentials
RISK_PUBLISHER_ENABLED=false
RISK_PUBLISHER_SECRET_KEY=

# Auth / API
JWT_SECRET=replace-with-at-least-32-random-bytes
API_KEY_PEPPER=replace-with-at-least-32-random-bytes

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@riskrail.dev

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
