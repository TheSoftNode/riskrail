# dependencies
node_modules/
.pnpm-store/

# builds
.next/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# database / local infra
*.db
*.sqlite
postgres-data/
redis-data/

# Clarinet
contracts/.cache/
contracts/.requirements/
contracts/settings/Devnet.toml.local
# Clarinet deployer mnemonics. These files hold the key that owns the registry
# contracts; only the .example templates belong in version control.
contracts/settings/Testnet.toml
contracts/settings/Mainnet.toml

# Deployment plans are derived and embed the deployer's own address, so each
# operator regenerates them rather than inheriting someone else's.
contracts/deployments/default.simnet-plan.yaml
contracts/deployments/default.testnet-plan.yaml
contracts/deployments/default.mainnet-plan.yaml

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# logs
*.log
logs/

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# local launcher that handles the publisher key
contracts/scripts/.run-publisher-worker.mjs

# Production secrets written on the server or by export-publisher-key.mjs
infrastructure/deploy/publisher.env
