{
  "name": "@rivisk/adapter-zest-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.ts",
    "lint": "eslint src --ext .ts",
    "validate:live": "tsx scripts/validate-live.ts"
  },
  "dependencies": {
    "@rivisk/adapter-core": "workspace:*",
    "@rivisk/stacks": "workspace:*",
    "@stacks/transactions": "^7.2.0"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
