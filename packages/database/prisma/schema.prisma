generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PositionType {
  WALLET
  STREAM
  LENDING
  BORROWING
  LIQUIDITY
  STAKING
  VAULT
}

enum AlertStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model User {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Optional: an account is usable with wallet auth alone. Email is only
  // needed to receive alert notifications.
  email           String?  @unique
  emailVerifiedAt DateTime?
  notifyByEmail   Boolean  @default(true)
  wallets         Wallet[]
  apiKeys         ApiKey[]
  webhooks        WebhookEndpoint[]
  notifications   Notification[]
}

/// One row per delivered (or attempted) notification, so a user can see what
/// was sent and the worker can avoid sending the same alert twice.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String
  subject    String
  body       String
  dedupeKey  String    @unique
  sentAt     DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Wallet {
  id              String              @id @default(cuid())
  address         String              @unique
  userId          String?
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lastIndexedAt   DateTime?
  positions       Position[]
  snapshots       PortfolioSnapshot[]
  riskSnapshots   RiskSnapshot[]
  alerts          AlertRule[]
  indexingRuns    IndexingRun[]
  policyBreaches  PolicyBreachEvent[]

  @@index([userId])
}

model Protocol {
  id             String     @id
  name           String
  protocolType   String
  enabled        Boolean    @default(true)
  adapterVersion Int        @default(1)
  contractIds    String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  positions      Position[]
}

model Position {
  id          String             @id
  walletId    String
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  protocolId  String
  protocol    Protocol           @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  type        PositionType
  valueUsd    Decimal?           @db.Decimal(38, 12)
  blockHeight BigInt
  exact       Boolean            @default(true)
  active      Boolean            @default(true)
  closedAt    DateTime?
  raw         Json
  observedAt  DateTime
  updatedAt   DateTime           @updatedAt
  assets      PositionAsset[]
  snapshots   PositionSnapshot[]

  @@index([walletId, active, observedAt])
  @@index([protocolId])
}

model PositionAsset {
  id           String   @id @default(cuid())
  positionId   String
  position     Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assetId      String
  symbol       String
  role         String
  amountAtomic String
  decimals     Int
  valueUsd     Decimal? @db.Decimal(38, 12)

  @@index([positionId])
  @@index([assetId])
}

model PositionSnapshot {
  id          String   @id @default(cuid())
  positionId  String
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  valueUsd    Decimal? @db.Decimal(38, 12)
  state       Json
  blockHeight BigInt
  observedAt  DateTime

  @@index([positionId, observedAt])
}

model PortfolioSnapshot {
  id                   String   @id @default(cuid())
  walletId             String
  wallet               Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  totalValueUsd        Decimal  @db.Decimal(38, 12)
  protocolValues       Json
  assetValues          Json
  valuationCoverageBps Int
  blockHeight          BigInt
  observedAt           DateTime

  @@index([walletId, observedAt])
}

model RiskSnapshot {
  id                       String   @id @default(cuid())
  walletId                 String
  wallet                   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  riskLevel                String
  riskScoreBps             Int
  healthFactorE4           Int?
  liquidationDistanceBps   Int?
  protocolConcentrationBps Int
  assetConcentrationBps    Int
  liquidityScoreBps        Int
  capitalAccessibilityBps  Int
  reportHash               String
  report                   Json
  methodologyVersion       String   @default("riskrail-v1")
  sourceBlock              BigInt
  onchainSnapshotId        BigInt?
  onchainTxId              String?
  observedAt               DateTime

  @@index([walletId, observedAt])
  @@index([reportHash])
}

model PriceObservation {
  id         String   @id @default(cuid())
  assetId    String
  symbol     String
  priceUsd   Decimal  @db.Decimal(38, 12)
  source     String
  observedAt DateTime

  @@index([assetId, observedAt])
}

model IndexingRun {
  id            String   @id @default(cuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  correlationId String   @unique
  sourceBlock   BigInt?
  status        String
  error         String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([walletId, startedAt])
}

model AlertRule {
  id        String      @id @default(cuid())
  walletId  String
  wallet    Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  metric    String
  operator  String
  threshold String
  channel   String
  status    AlertStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  events    AlertEvent[]

  @@index([walletId, status])
}

model AlertEvent {
  id          String    @id @default(cuid())
  alertId     String
  alert       AlertRule @relation(fields: [alertId], references: [id], onDelete: Cascade)
  value       String
  metadata    Json
  triggeredAt DateTime  @default(now())

  @@index([alertId, triggeredAt])
}

model PolicyBreachEvent {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  source      String   @default("onchain-policy")
  metric      String
  operator    String
  threshold   String
  value       String
  sourceBlock BigInt
  metadata    Json
  triggeredAt DateTime @default(now())

  @@index([walletId, triggeredAt])
  @@index([walletId, metric, triggeredAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefix     String
  hash       String
  name       String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model WebhookEndpoint {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  secretCipher String   // AES-256-GCM, see packages/webhooks
  events       String[]
  enabled      Boolean           @default(true)
  createdAt    DateTime          @default(now())
  deliveries   WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId     String
  statusCode  Int?
  attempt     Int             @default(1)
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([endpointId, createdAt])
}

model IndexedBlock {
  height    BigInt   @id
  blockHash String   @unique
  indexedAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
