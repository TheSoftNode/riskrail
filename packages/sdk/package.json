{
  "name": "@rivisk/sdk",
  "version": "0.1.1",
  "description": "Typed client for the Rivisk risk intelligence API.",
  "keywords": [
    "stacks",
    "sbtc",
    "bitcoin",
    "defi",
    "risk",
    "liquidation",
    "portfolio"
  ],
  "license": "MIT",
  "author": "TheSoftNode",
  "homepage": "https://github.com/TheSoftNode/rivisk/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheSoftNode/rivisk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/TheSoftNode/rivisk/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.ts",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "socket.io-client": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
