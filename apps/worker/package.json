{
  "name": "@rivisk/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.shared.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@rivisk/adapter-core": "workspace:*",
    "@rivisk/database": "workspace:*",
    "@rivisk/logger": "workspace:*",
    "@rivisk/notifications": "workspace:*",
    "@rivisk/queue": "workspace:*",
    "@rivisk/risk-engine": "workspace:*",
    "@rivisk/rivisk-contracts": "workspace:*",
    "@rivisk/webhooks": "workspace:*",
    "bullmq": "6.3.6"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "vitest": "^3.2.4",
    "@types/node": "^22.18.0"
  }
}
