{
  "name": "@riskrail/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@riskrail/adapter-core": "workspace:*",
    "@riskrail/database": "workspace:*",
    "@riskrail/logger": "workspace:*",
    "@riskrail/notifications": "workspace:*",
    "@riskrail/queue": "workspace:*",
    "@riskrail/risk-engine": "workspace:*",
    "@riskrail/riskrail-contracts": "workspace:*",
    "@riskrail/webhooks": "workspace:*",
    "bullmq": "6.3.6"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "vitest": "^3.2.4",
    "@types/node": "^22.18.0"
  }
}
