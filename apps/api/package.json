    "lint": "eslint src --ext .ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.0.0",
    "@rivisk/adapter-core": "workspace:*",
    "@rivisk/database": "workspace:*",
    "@rivisk/queue": "workspace:*",
    "@rivisk/risk-engine": "workspace:*",
    "@rivisk/rivisk-contracts": "workspace:*",
    "@rivisk/stacks": "workspace:*",
    "@rivisk/webhooks": "workspace:*",
    "@stacks/encryption": "^7.2.0",
    "@stacks/transactions": "^7.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "vitest": "^5.0.1",
    "@rivisk/sdk": "workspace:*"
