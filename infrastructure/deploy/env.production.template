# Copied to .env.production by setup-env.sh, which fills every __GENERATED__
# value with a fresh random secret on the server. Never commit the result.

# --- Public hosts (Caddy issues certificates for these) ---
API_HOST=__API_HOST__
REALTIME_HOST=__REALTIME_HOST__
# The Vercel site. Comma-separate several origins (production + custom domain).
WEB_URL=__WEB_URL__
API_URL=https://__API_HOST__

# --- Core ---
LOG_LEVEL=info
API_PORT=4000
REALTIME_PORT=4001
# Caddy is the one proxy in front of the API.
TRUST_PROXY_HOPS=1

# --- Persistence (compose builds DATABASE_URL and REDIS_URL from these) ---
POSTGRES_PASSWORD=__GENERATED__
REDIS_PASSWORD=__GENERATED__

# --- Secrets ---
JWT_SECRET=__GENERATED__
API_KEY_PEPPER=__GENERATED__
WEBHOOK_ENCRYPTION_KEY=__GENERATED__
CHAINHOOK_AUTH_TOKEN=__GENERATED__

# --- Stacks ---
STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
# Optional, raises Hiro's rate limits: https://platform.hiro.so
STACKS_API_KEY=

# --- Protocol adapters (off unless set) ---
ZEST_V2_ENABLED=false
BITPAY_CORE_CONTRACT=

# --- Pricing (optional; the free tier works without a key) ---
COINGECKO_API_KEY=

# --- Contracts (contracts/deployments/testnet.json) ---
RISK_REGISTRY_CONTRACT=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7.risk-registry
RISK_POLICY_CONTRACT=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7.risk-policy
PROTOCOL_REGISTRY_CONTRACT=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7.protocol-registry

# --- Attestation publishing ---
# Turn on only after publisher.env holds RISK_PUBLISHER_SECRET_KEY. Every risk
# snapshot then costs one testnet transaction.
RISK_PUBLISHER_ENABLED=false
# Publish an unchanged snapshot at most once per this many source blocks
# (~9.6 s each on testnet; 120 ≈ 19 min). A changed figure publishes at once.
# Keep it below the 144-block freshness bound consumers are told to use. 0 = off.
ATTESTATION_MIN_INTERVAL_BLOCKS=120

# --- Email alerts (optional; disabled when SMTP_HOST is empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Demo wallets indexed on every start (optional, comma-separated) ---
MONITORED_WALLETS=
